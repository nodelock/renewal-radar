# pnpm: ensure platform-native optional deps (e.g. @rollup/rollup-linux-x64-gnu)
# are installed/linked on the deploy platform, avoiding the "Cannot find module
# @rollup/rollup-linux-x64-gnu" optional-dependency bug (npm/cli#4828) on Vercel.
supportedArchitectures[libc]=glibc
supportedArchitectures[platform]=linux
supportedArchitectures[arch]=x64

# Minimal private deployment configuration for Vercel.
# Never commit real values to the repository.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
VITE_GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_ALLOWED_USER_ID=your-github-numeric-user-id
SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-long-random-cron-secret

# Required only if Telegram reminders are enabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: only needed when using an external scheduler instead of Vercel Cron.
# SCHEDULED_TASK_SECRET=replace-with-a-long-random-scheduler-secret

# Optional: defaults to the project repository when omitted.
# VITE_REPO_URL=https://github.com/nodelock/renewal-radar

# Copy these names into Vercel, Netlify, or another secret manager.
# For a private single-owner deployment, this is the complete required set.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
VITE_GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_ALLOWED_USER_ID=your-github-numeric-user-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SESSION_SECRET=replace-with-at-least-32-random-characters
SCHEDULED_TASK_SECRET=replace-with-a-long-random-scheduler-secret
CRON_SECRET=use-the-same-value-as-SCHEDULED_TASK_SECRET
VITE_REPO_URL=https://github.com/nodelock/renewal-radar
